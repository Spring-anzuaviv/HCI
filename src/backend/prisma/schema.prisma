// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Store {
  storeId      Int         @id @default(autoincrement()) @map("store_id")
  name         String      @db.VarChar(100)
  address      String?     @db.VarChar(100)
  email        String      @unique @db.VarChar(255)
  passwordHash String      @map("password_hash") @db.VarChar(255)
  employees    Employee[]
  shifts       WorkShift[]
  machines     Machine[]

  @@map("stores")
}

model Customer {
  customerId Int            @id @default(autoincrement()) @map("customer_id")
  name       String         @db.VarChar(50)
  phone      String         @unique @db.VarChar(12)
  orders     LaundryOrder[]

  @@map("customers")
}

model Employee {
  employeeId Int                 @id @default(autoincrement()) @map("employee_id")
  storeId    Int                 @map("store_id")
  name       String              @db.VarChar(50)
  role       String              @db.VarChar(50)
  createdAt  DateTime            @default(now()) @map("created_at")
  store      Store               @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  shifts     EmployeeWorkShift[]

  @@map("employees")
}

model WorkShift {
  shiftId   Int                 @id @default(autoincrement()) @map("shift_id")
  storeId   Int                 @map("store_id")
  name      String              @db.VarChar(50)
  startAt   DateTime            @map("start_at")
  endAt     DateTime            @map("end_at")
  workDate  DateTime            @map("work_date") @db.Date
  store     Store               @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  employees EmployeeWorkShift[]

  @@map("work_shifts")
}

model EmployeeWorkShift {
  employeeId Int       @map("employee_id")
  shiftId    Int       @map("shift_id")
  employee   Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  shift      WorkShift @relation(fields: [shiftId], references: [shiftId], onDelete: Cascade)

  @@id([employeeId, shiftId])
  @@map("employee_work_shifts")
}

model Machine {
  machineId         Int          @id @default(autoincrement()) @map("machine_id")
  storeId           Int          @map("store_id")
  name              String       @db.VarChar(100)
  status            String       @db.VarChar(20)
  type              String       @db.VarChar(10)
  capacityKg        Float        @map("capacity_kg")
  processingMinutes Int          @map("processing_minutes")
  store             Store        @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  stages            OrderStage[]

  @@map("machines")
}

model LaundryOrder {
  orderId     Int          @id @default(autoincrement()) @map("order_id")
  customerId  Int          @map("customer_id")
  weightKg    Decimal      @map("weight_kg") @db.Decimal(5, 2)
  serviceType String       @map("service_type") @db.VarChar(50)
  status      String       @db.VarChar(50)
  readyAt     DateTime?    @map("ready_at")
  pickupAt    DateTime?    @map("pickup_at")
  estimatedAt DateTime?    @map("estimated_at")
  groupCode   String?      @map("group_code") @db.VarChar(100)
  completedAt DateTime?    @map("completed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  customer    Customer     @relation(fields: [customerId], references: [customerId])
  stages      OrderStage[]

  @@index([groupCode])
  @@index([status])
  @@index([pickupAt])
  @@map("laundry_orders")
}

model OrderStage {
  orderStageId    Int          @id @default(autoincrement()) @map("order_stage_id")
  orderId         Int          @map("order_id")
  machineId       Int?         @map("machine_id")
  stage           String       @db.VarChar(50)
  plannedStartAt  DateTime?    @map("planned_start_at")
  plannedEndAt    DateTime?    @map("planned_end_at")
  actualStartedAt DateTime?    @map("actual_started_at")
  actualEndedAt   DateTime?    @map("actual_ended_at")
  status          String       @db.VarChar(20)
  order           LaundryOrder @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  machine         Machine?     @relation(fields: [machineId], references: [machineId], onDelete: SetNull)

  @@index([orderId, stage])
  @@index([machineId, status, plannedStartAt])
  @@map("order_stages")
}
